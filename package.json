  "homepage": "https://github.com/vishalmeena2211/mac-app-dualizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishalmeena2211/mac-app-dualizer.git"
  },
  "bugs": {
    "url": "https://github.com/vishalmeena2211/mac-app-dualizer/issues"
  },
